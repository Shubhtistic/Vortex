# --- CORS ---
# Production: Set to your deployed frontend URL (e.g., "https://app.yourdomain.com")
# Development: Use "*" to allow all origins (ngrok, localhost, Vercel preview URLs)
ALLOWED_ORIGINS=["*"]
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]
ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# --- Redpanda ---
REDPANDA_BOOTSTRAP_SERVERS=localhost:9092
REDPANDA_CLIENT_ID=vortex
REDPANDA_SECURITY_PROTOCOL=PLAINTEXT
REDPANDA_REQUEST_TIMEOUT_MS=40000
REDPANDA_MAX_BATCH_SIZE=16384
REDPANDA_EVENTS_TOPIC=vortex.events
REDPANDA_START_MAX_ATTEMPTS=5
REDPANDA_SEND_TIMEOUT_SECONDS=10.0
REDPANDA_SASL_MECHANISM=PLAIN
REDPANDA_SASL_USERNAME=
REDPANDA_SASL_PASSWORD=
