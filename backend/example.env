# --- Postgres ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vortex
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=vortex

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_MAX_CONNECTIONS=10
REDIS_POOL_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=2
API_KEY_CACHE_TTL_SECONDS=30
API_KEY_CACHE_MAX_SIZE=10000
REDIS_DB_FALLBACK_CONCURRENCY=5
REDIS_DB_FALLBACK_WAIT_SECONDS=0.5
REDIS_MAXMEMORY=192mb

# --- Granian ASGI server ---
GRANIAN_WORKERS=2
# Per-worker connection backpressure; set for the deployment's keep-alive load.
GRANIAN_BACKPRESSURE=2000
# Trusted Docker proxy network CIDR; replace if the Compose subnet differs.
GRANIAN_PROXY_TRUSTED_HOSTS=172.16.0.0/12

# --- Application ---
ENVIRONMENT=development
PROJECT_NAME=Vortex
VERSION=0.1.0
DOCS_ENDPOINT=/docs

# --- JWT ---
# Replace these placeholders with a matching test key pair before testing auth.
JWT_PRIVATE_KEY=replace-with-a-test-private-key
JWT_PUBLIC_KEY=replace-with-the-matching-test-public-key
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# --- Project ---
API_KEY_PREFIX=vk_
GRACE_PERIOD_MINS=6

# --- CORS ---
# Production: Set to your deployed frontend URL (e.g., "https://app.yourdomain.com")
# Development: Use "*" to allow all origins (ngrok, localhost, Vercel preview URLs)
ALLOWED_ORIGINS=["*"]
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]
ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# --- Redpanda ---
# Docker services on my-redpanda-net must use Redpanda's internal listener.
REDPANDA_BOOTSTRAP_SERVERS=redpanda:19092
REDPANDA_CLIENT_ID=vortex
REDPANDA_SECURITY_PROTOCOL=PLAINTEXT
REDPANDA_REQUEST_TIMEOUT_MS=40000
REDPANDA_MAX_BATCH_SIZE=16384
REDPANDA_EVENTS_TOPIC=vortex.events
REDPANDA_DLQ_TOPIC=vortex.events.dlq
REDPANDA_EVENTS_PARTITIONS=12
REDPANDA_CONSUMER_GROUP_ID=vortex-events-postgres
REDPANDA_START_MAX_ATTEMPTS=5
REDPANDA_SEND_TIMEOUT_SECONDS=10.0
REDPANDA_SASL_MECHANISM=PLAIN
REDPANDA_SASL_USERNAME=
REDPANDA_SASL_PASSWORD=

# --- Event buffer ---
EVENT_BUFFER_MAX_BATCH_SIZE=1000
EVENT_BUFFER_FLUSH_INTERVAL_SECONDS=1.0
EVENT_BUFFER_MAX_PENDING_EVENTS=50000
EVENT_BUFFER_MAX_PENDING_BYTES=67108864
EVENT_BUFFER_SHUTDOWN_TIMEOUT_SECONDS=30.0
