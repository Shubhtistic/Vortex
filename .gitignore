# dont let python cache or compiled files go to github 
__pycache__/
*.py[cod]
*$py.class
seed.py
.pytest_cache/
.devcontainer/

# virtual environments are massive folders we dont need on git
venv/
env/
.venv/

# this is for streamlit secrets management 
# secrets.toml has our real api urls and keys so keep it local only
# we only push the .example.toml file so others know the structure
dashboard/.streamlit/secrets.toml


# the double asterisk means 'look in any subfolder'
# this ensures the dashboard/.streamlit/ folder is caught
**/dashboard/.streamlit/secrets.toml
**/.streamlit/

# critical security for backend environment variables
.env
.env.local

# ide settings like vs code or pycharm should not be shared
.vscode/
.idea/

# never push database files or logs to the repository
*.sqlite3
*.db
*.log
celerybeat-schedule

# junk files created by the operating system
.DS_Store
Thumbs.db